
&НаСервере
Функция ПолучитьЗаписиРегистра() Экспорт
    // Создаем выборку из регистра сведений
    Выборка = РегистрыСведений.КалендарьЗаписей.Выбрать();
    
    Результат = Новый СписокЗначений;
    
    Пока Выборка.Следующий() Цикл
        // Добавляем записи в результат
        Запись = Новый Структура;      
		
        Запись.Вставить("Регистратор", Выборка.Регистратор);
        Запись.Вставить("Клиент", Выборка.Клиент);
        Запись.Вставить("ДатаВизита", Выборка.ДатаВизита);
        Запись.Вставить("Мастер", Выборка.Мастер);
        Запись.Вставить("Услуга", Выборка.Услуга);
        Запись.Вставить("Статус", Выборка.Статус);
        Запись.Вставить("Длительность", Выборка.Длительность);
        Результат.Добавить(Запись);
    КонецЦикла;
    
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОбновитьПланировщик(ДополнительныеПараметры, Результат) Экспорт
	// Загружаем данные из регистра
	Записи = ПолучитьЗаписиРегистра();
	
	Планировщик.Элементы.Очистить();
	Для Каждого Запись Из Записи Цикл
		Элемент = Планировщик.Элементы.Добавить(Запись.Значение.ДатаВизита, Запись.Значение.ДатаВизита +  Запись.Значение.Длительность * 60);
		Элемент.Текст = Строка(Запись.Значение.Услуга) + " - " + Строка(Запись.Значение.Клиент) + " мастер: " + Строка(Запись.Значение.Мастер);
   		Элемент.Значение = Запись.Значение.Регистратор;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	// Загружаем данные из регистра
	Записи = ПолучитьЗаписиРегистра();
	
	Планировщик.Элементы.Очистить();
	Для Каждого Запись Из Записи Цикл
		Элемент = Планировщик.Элементы.Добавить(Запись.Значение.ДатаВизита, Запись.Значение.ДатаВизита +  Запись.Значение.Длительность * 60);
		Элемент.Текст = Строка(Запись.Значение.Услуга) + " - " + Строка(Запись.Значение.Клиент) + " мастер: " + Строка(Запись.Значение.Мастер);
   		Элемент.Значение = Запись.Значение.Регистратор;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ЗакрытиеФормыЗаписи" Тогда
		ПриОткрытии(Ложь);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикЗаписейПередУдалением(Элемент, Отказ)
	
	Если Не Отказ Тогда
		ОчисткаЗаписи(Элемент.ВыделенныеЭлементы[0].Значение);
	КонецЕсли;
	
КонецПроцедуры         

&НаСервере
Процедура ОчисткаЗаписи(Запись)
	
	ДокументОбъект = Запись.ПолучитьОбъект();	
	ДокументОбъект.УстановитьПометкуУдаления(Истина);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПланировщикЗаписейПередСозданием(Элемент, Начало, Конец, ЗначенияИзмерений, Текст, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Запись = Новый Структура;      
	Запись.Вставить("Дата", ТекущаяДата());
	Запись.Вставить("ДатаВизита", Начало); 
	//Запись.Вставить("Ключ", Элемент.ВыделенныеЭлементы[0].Значение); 
	
	ОткрытьФорму("Документ.ЗаписьНаУслугу.Форма.ФормаДокумента", Запись, ЭтотОбъект, , , ,Новый ОписаниеОповещения("ОбновитьПланировщик", ЭтотОбъект));
	
КонецПроцедуры

